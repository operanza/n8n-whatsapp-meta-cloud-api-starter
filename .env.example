# Token arbitrário definido por você e cadastrado no painel de Webhooks da Meta
WHATSAPP_VERIFY_TOKEN=defina_um_token_de_verificacao_seguro

# ID do número de telefone obtido em Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# O Access Token (Bearer) deve ser configurado na credencial "Header Auth" dentro do n8n,
# nunca hardcoded no JSON do workflow ou versionado neste arquivo.
# O App Secret (para validar X-Hub-Signature-256) deve ser injetado apenas no servidor/proxy.
